#!/bin/sh
#
# Blocks a commit that would introduce a live credential.
#
# This hook is NOT active by default — Git only runs hooks from .git/hooks
# unless the repo is pointed at this directory. Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
# Until that is run, this file is inert. `tools/Launch-Sprout-Claude.ps1` and the
# README both mention it; if you are reading this because a secret leaked, that
# config line is probably what was missing.

set -u

secret_patterns='AIza[0-9A-Za-z_-]{35}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{20,}|sk-[0-9A-Za-z_-]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

[ -n "$staged_files" ] || exit 0

# A predictable path in a world-writable directory is the wrong place for this;
# the scan output can quote the secret it just found.
scan_output="$(mktemp "${TMPDIR:-/tmp}/sprout-secret-scan.XXXXXX")" || exit 1
trap 'rm -f "$scan_output"' EXIT INT TERM

found_secret=0

# Every offending file is reported, not just the first: stopping at one hides the
# rest and turns cleanup into several rounds.
#
# Only stdout is captured. Folding stderr in here and then judging the file by
# non-emptiness made any noise from git — a locale warning, an unresolvable
# pathspec, a filename containing glob characters — look exactly like a detected
# secret and block the commit with nothing to show for it.
echo "$staged_files" | while IFS= read -r path; do
  [ -n "$path" ] || continue
  # git grep: 0 = match, 1 = no match, >1 = it could not scan the file. Collapsing
  # the last two into "clean" would silently skip a file the scanner choked on —
  # a name with pathspec magic, an unreadable blob — which is the one case where
  # a secret is most likely to slip through unnoticed.
  grep_stderr="$(git grep --cached -nI -E "$secret_patterns" -- "$path" 2>&1 1>&3)"
  status=$?
  case "$status" in
    0) echo "  ^ potential secret in staged file: $path" ;;
    1) : ;;
    *) echo "  ! could not scan staged file: $path ${grep_stderr:+($grep_stderr)}" ;;
  esac
done 3>&1 > "$scan_output"

if [ -s "$scan_output" ]; then
  cat "$scan_output" >&2
  found_secret=1
fi

if [ "$found_secret" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked. Move live secrets into an ignored local config file" >&2
  echo "(see Sprout-html/sprout-firebase-config.example.js) before committing." >&2
  exit 1
fi

exit 0
